# Copy this file to .env and fill in real values. Do not commit .env.
# Compose reads variables from .env automatically; the app reads them
# via ${VAR} placeholders in src/main/resources/application.properties.

# ─── Bootstrap admin (created on first startup if no admin exists) ─────────
ADMIN_EMAIL=admin@eventsnest.com
ADMIN_PASSWORD=change-me-before-prod
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

# ─── Email provider ────────────────────────────────────────────────────────
# Default is brevo (HTTP API). Set MAIL_PROVIDER=gmail to switch to Gmail SMTP.
MAIL_PROVIDER=brevo

# Brevo: required when MAIL_PROVIDER=brevo. Get a key at https://app.brevo.com.
BREVO_API_KEY=
# Optional sender override (defaults to Brevo's sandbox address).
# FROM_EMAIL=EventsNest <noreply@yourdomain.com>

# Gmail SMTP: required when MAIL_PROVIDER=gmail.
# GMAIL_USERNAME=
# GMAIL_APP_PASSWORD=

# ─── Frontend ──────────────────────────────────────────────────────────────
# Used to build deep links inside transactional emails (check-in invites etc.).
FRONTEND_URL=http://localhost:5173

# ─── JWT signing ───────────────────────────────────────────────────────────
# Must be at least 32 chars for HMAC-SHA256.
JWT_SIGNING_KEY=boom-supersonic-flight-secret-key-long-enough

# ─── Monnify payment gateway (M3.2) ────────────────────────────────────────
# Default is the stub client (no network, no real money) so local dev can
# run the full booking → checkout → ticket-issuance flow against fake URLs.
# Set MONNIFY_ENABLED=true in staging/prod and provide the four credentials
# below from your Monnify dashboard.
MONNIFY_ENABLED=false
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# MONNIFY_BASE_URL=https://sandbox.monnify.com
# Where Monnify sends the user after checkout completes (success or fail).
# MONNIFY_REDIRECT_URL=http://localhost:5173/payment-result

# ─── Datasource (Compose overrides these for in-network Postgres) ─────────
# Only needed when running outside Compose (e.g. `mvn spring-boot:run` against
# host Postgres). Inside Compose, the app block in compose.yaml sets these.
# Postgres requires the database to exist before the app starts — create it
# locally with: createdb events_nest_db
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/events_nest_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
