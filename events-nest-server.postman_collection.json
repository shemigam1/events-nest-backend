{
  "info": {
    "name": "Events Nest — User Flow",
    "description": "End-to-end happy-path: organiser submits an event, admin approves it, attendee books and cancels.\n\nRun the requests in order. Tokens and IDs are saved to collection variables automatically.\n\nThe default admin is seeded on startup by AdminInitializer using `admin.email` / `admin.password` from application.properties.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080" },
    { "key": "orgEmail",      "value": "ada@example.com" },
    { "key": "attEmail",      "value": "grace@example.com" },
    { "key": "password",      "value": "secret123" },
    { "key": "adminEmail",    "value": "admin@eventsnest.com" },
    { "key": "adminPassword", "value": "admin-change-me" },
    { "key": "orgToken",      "value": "" },
    { "key": "attToken",      "value": "" },
    { "key": "adminToken",    "value": "" },
    { "key": "eventId",       "value": "" },
    { "key": "tierId",        "value": "" },
    { "key": "bookingId",     "value": "" }
  ],
  "item": [
    {
      "name": "1. Register Organiser",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"{{orgEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));"
        ]}
      }]
    },
    {
      "name": "2. Login Organiser",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{orgEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.data.accessToken).to.be.a('string');",
          "pm.collectionVariables.set('orgToken', body.data.accessToken);"
        ]}
      }]
    },
    {
      "name": "3. Create Event (DRAFT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{orgToken}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/events", "host": ["{{baseUrl}}"], "path": ["api","v1","events"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Spring Boot Conf 2026\",\n  \"venue\": \"Lagos Convention Centre\",\n  \"startTime\": \"2026-09-01T10:00:00\",\n  \"endTime\":   \"2026-09-01T18:00:00\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.expect(body.data.id).to.be.a('string');",
          "pm.collectionVariables.set('eventId', body.data.id);"
        ]}
      }]
    },
    {
      "name": "4. Create Ticket Tier",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{orgToken}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/tiers",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","events","{{eventId}}","tiers"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"VIP\",\n  \"price\": 50000,\n  \"rowPrefix\": \"V\",\n  \"rowCount\": 5,\n  \"seatsPerRow\": 10\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.expect(body.data.id).to.be.a('string');",
          "pm.collectionVariables.set('tierId', body.data.id);"
        ]}
      }]
    },
    {
      "name": "5. Submit Event for Approval",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{orgToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/submit",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","events","{{eventId}}","submit"]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.expect(pm.response.json().data.status).to.eql('PENDING_APPROVAL');"
        ]}
      }]
    },
    {
      "name": "6a. Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "description": "Default admin is seeded on startup by AdminInitializer using `admin.email` and `admin.password` from application.properties."
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.data.accessToken).to.be.a('string');",
          "pm.collectionVariables.set('adminToken', body.data.accessToken);"
        ]}
      }]
    },
    {
      "name": "6b. Admin: List Pending Events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/events?status=PENDING_APPROVAL",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","admin","events"],
          "query": [{ "key": "status", "value": "PENDING_APPROVAL" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Pending queue contains our event', () => {",
          "  const ids = pm.response.json().content.map(e => e.id);",
          "  pm.expect(ids).to.include(pm.collectionVariables.get('eventId'));",
          "});"
        ]}
      }]
    },
    {
      "name": "6c. Admin: Approve Event",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}/approve",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","admin","events","{{eventId}}","approve"]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Event status is PUBLISHED', () => {",
          "  pm.expect(pm.response.json().data.status).to.eql('PUBLISHED');",
          "});"
        ]}
      }]
    },
    {
      "name": "7. Register Attendee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\",\n  \"email\": \"{{attEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));"
        ]}
      }]
    },
    {
      "name": "8. Login Attendee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{attEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.data.accessToken).to.be.a('string');",
          "pm.collectionVariables.set('attToken', body.data.accessToken);"
        ]}
      }]
    },
    {
      "name": "9. List Published Events (public)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/events", "host": ["{{baseUrl}}"], "path": ["api","v1","events"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Created event is listed', () => {",
          "  const ids = pm.response.json().map(e => e.id);",
          "  pm.expect(ids).to.include(pm.collectionVariables.get('eventId'));",
          "});"
        ]}
      }]
    },
    {
      "name": "10. Create Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{attToken}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/bookings",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","events","{{eventId}}","bookings"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tierId\": \"{{tierId}}\",\n  \"quantity\": 2\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.expect(body.data.tickets).to.have.length(2);",
          "pm.collectionVariables.set('bookingId', body.data.id);"
        ]}
      }]
    },
    {
      "name": "11. List My Bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{attToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/me/bookings", "host": ["{{baseUrl}}"], "path": ["api","v1","me","bookings"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Includes the booking we just made', () => {",
          "  const ids = pm.response.json().map(b => b.id);",
          "  pm.expect(ids).to.include(pm.collectionVariables.get('bookingId'));",
          "});"
        ]}
      }]
    },
    {
      "name": "12. List My Tickets",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{attToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/me/tickets", "host": ["{{baseUrl}}"], "path": ["api","v1","me","tickets"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Two VALID tickets', () => {",
          "  const valid = pm.response.json().filter(t => t.status === 'VALID');",
          "  pm.expect(valid.length).to.eql(2);",
          "});"
        ]}
      }]
    },
    {
      "name": "13. Cancel Booking",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{attToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/bookings/{{bookingId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","events","{{eventId}}","bookings","{{bookingId}}","cancel"]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.expect(pm.response.json().data.status).to.eql('CANCELLED');"
        ]}
      }]
    },
    {
      "name": "14. Verify Refund + Capacity Restored",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{attToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/me/tickets", "host": ["{{baseUrl}}"], "path": ["api","v1","me","tickets"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('All tickets are REFUNDED', () => {",
          "  const tickets = pm.response.json();",
          "  pm.expect(tickets).to.have.length.greaterThan(0);",
          "  tickets.forEach(t => pm.expect(t.status).to.eql('REFUNDED'));",
          "});"
        ]}
      }]
    }
  ]
}
