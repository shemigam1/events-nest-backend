<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!--
        Pull Spring Boot's default logback setup so we can override individual
        appenders. Without this we'd lose the colour conversion rules and the
        out-of-the-box level conventions.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName"
                    source="spring.application.name"
                    defaultValue="events-nest-server"/>
    <springProperty scope="context" name="logPath"
                    source="logging.file.path"
                    defaultValue="/app/logs"/>

    <!--
        TEST profile — keep the default plain-text format so test output
        stays readable during `mvn test` and CI logs.
    -->
    <springProfile name="test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!--
        Everything else (local, dev, prod) — JSON to stdout AND a rolling
        file. stdout is what `docker compose logs` shows; the file is what
        the Phase C log shipper will eventually push to S3.
    -->
    <springProfile name="!test">

        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${appName}"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>component</includeMdcKeyName>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <level>level</level>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
            </encoder>
        </appender>

        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${logPath}/app.log</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${appName}"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>component</includeMdcKeyName>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <level>level</level>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${logPath}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>

        <!-- Quiet some chatty libraries. Hibernate SQL stays at the level
             the user has chosen via `spring.jpa.show-sql`. -->
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="org.springframework.kafka.listener.KafkaMessageListenerContainer" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>

    </springProfile>
</configuration>
